{
  "version": 2,
  "rewrites": [
    {
      "source": "/card/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/cards",
      "destination": "/index.html"
    },
    {
      "source": "/sets",
      "destination": "/index.html"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|cards\\.json|seo-cards\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
